# Copie para .env.local. Sem estas variáveis o app roda em modo demonstração
# (estante salva só no navegador, sem login).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# "true" depois de configurar o provedor GitHub em Authentication > Providers
NEXT_PUBLIC_AUTH_GITHUB=false
