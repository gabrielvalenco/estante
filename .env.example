# Copie para .env.local. Sem DATABASE_URL e AUTH_SECRET, o app roda em modo
# demonstração (estante salva só no navegador, sem login).

# Postgres. Em produção, a connection string *pooled* do Neon
# (Vercel > Storage > Neon, ou console.neon.tech). Localmente, o Docker do README.
DATABASE_URL=postgres://postgres:postgres@localhost:54330/estante

# Segredo das sessões. Gere com: npx auth secret
AUTH_SECRET=

# GitHub OAuth App (github.com/settings/developers).
# Callback URL: https://SEU-APP.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth (console.cloud.google.com > APIs e serviços > Credenciais).
# URI de redirecionamento: https://SEU-APP.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# E-mail e senha não precisam de variável: funcionam sempre que há banco e AUTH_SECRET.

# Login de teste sem senha. Só funciona com `npm run dev` (NODE_ENV=development).
ENABLE_DEV_LOGIN=false

# Política de privacidade (LGPD): controlador e canal de contato. Opcionais;
# sem e-mail, a política aponta para o repositório do projeto.
NEXT_PUBLIC_CONTROLLER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# Endereço público do site, usado para verificar redes sociais (o link que a pessoa
# coloca na bio do GitHub/Bluesky). Na Vercel não precisa: usa o domínio de produção.
NEXT_PUBLIC_SITE_URL=

# Links de afiliado (botão "Comprar na Amazon" na página do livro).
# Sua tag do Associados Amazon Brasil, ex.: "seunome-20". Sem ela, o botão não aparece.
AMAZON_ASSOCIATE_TAG=

# Fotos de perfil (Vercel Blob). Na Vercel: Storage → Create → Blob, conectado ao projeto (a variável é criada sozinha).
# Sem ela: em desenvolvimento as fotos vão para public/uploads/avatars; em produção o envio fica desligado.
BLOB_READ_WRITE_TOKEN=

# Assinaturas (Stripe). Chave secreta: Stripe → Developers → API keys (sk_test_ no modo de teste, sk_live_ em produção).
# Depois de colocar a chave, rode: npm run stripe:setup  (cria o produto Capa Dura e os preços)
STRIPE_SECRET_KEY=
# Segredo do webhook: Stripe → Developers → Webhooks → endpoint https://SEU-SITE/api/stripe/webhook
# (eventos: checkout.session.completed, customer.subscription.created, .updated e .deleted)
STRIPE_WEBHOOK_SECRET=

# Citação por foto: o Claude lê a foto da página (console.anthropic.com → API Keys).
# Sem ela, o botão "Ler de uma foto" aparece como "em breve". Modelo padrão: claude-haiku-4-5.
ANTHROPIC_API_KEY=
# ANTHROPIC_OCR_MODEL=claude-haiku-4-5
